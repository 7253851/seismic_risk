      "description": "run_protected.sh与run_pyqgis.sh默认在沙箱中运行：禁止写入采用图、论文、QGIS主资产、最终版式源包（layout/work除外）、共享样式、索引、data/及历史目录；工作输出、layout/work/与result/可写。确需重建主工程、最终版式源包或发布时设置SEISMIC_ALLOW_PROTECTED_WRITES=1，完成后用sync_figures.py同步。",
      "protected": [
        "figures/",
        "manuscript/",
        "JPEG/",
        "data/",
        "drafts/",
        "backups/",
        "archive/",
        "change_logs/",
        "plot/figure_index.json",
        "plot/shared/styles/",
        "plot/*/output/final/",
        "plot/NN_*/qgis/",
        "plot/*/layout/ (layout/work/除外)"
      ],
      "opt_in_env": "SEISMIC_ALLOW_PROTECTED_WRITES=1"
    }
