(version 1)
; Write protection applied by plot/shared/run_protected.sh and run_pyqgis.sh.
; Figure scripts may write working outputs (plot/*/output except final/, layout/work/, result/),
; but never adopted figures, the manuscript, QGIS master assets, final layout packages or history.
; Override for an intentional rebuild: SEISMIC_ALLOW_PROTECTED_WRITES=1
(allow default)
(deny file-write*
  (subpath "@ROOT@/figures")
  (subpath "@ROOT@/manuscript")
  (subpath "@ROOT@/JPEG")
  (subpath "@ROOT@/data")
  (subpath "@ROOT@/drafts")
  (subpath "@ROOT@/backups")
  (subpath "@ROOT@/archive")
  (subpath "@ROOT@/change_logs")
  (literal "@ROOT@/plot/figure_index.json")
  (subpath "@ROOT@/plot/shared/styles")
  (regex #"^@ROOT@/plot/[^/]+/output/final(/|$)")
  (regex #"^@ROOT@/plot/[0-9][0-9]_[^/]+/qgis(/|$)")
  (regex #"^@ROOT@/plot/[^/]+/layout(/|$)"))
(allow file-write*
  (regex #"^@ROOT@/plot/[^/]+/layout/work(/|$)"))
